+def build_count_config(args):
+    """Profile defaults, then explicit command-line overrides on top."""
+    cfg = cr.PROFILES[args.profile] if args.profile else cr.PROFILES["baseline"]
+    overrides = {}
+    for name in ("rule", "min_uncovered", "min_track_frames", "merge_tracks",
+                 "merge_iou", "merge_min_common", "handover", "handover_iou",
+                 "handover_max_gap", "seed_policy", "bidirectional"):
+        value = getattr(args, name)
+        if value is not None:
+            overrides[name] = value
+    cfg = cfg.with_(**overrides)
+    cfg = cfg.with_(obj_batch_size=args.obj_batch_size, min_obj_area=args.min_obj_area)
+    return cfg.validate()
