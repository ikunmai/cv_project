+def get_box_inputs(prompts):
+    box_inputs = []
+    for prompt in prompts:
+        if prompt[2] == 2.0 and prompt[5] == 3.0:
+            box_inputs.append([prompt[0], prompt[1], prompt[3], prompt[4]])
+
+    return box_inputs
