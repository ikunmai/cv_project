+def get_pseudo_exemplars(model_output, image_size, box_threshold, num_exemplars=10,
+                         strategy="topk", nms_iou=0.4, grid=4, min_side=2.0):
+    """Box prompts for the next frame, selected by counting_rules.
+
+    ``strategy="topk"`` is the v1 rule (threshold + highest scores); ``"diverse"``
+    additionally removes near-duplicate prompts and spreads the selection over a
+    grid, which matters in dense scenes where the top scores all sit on the same
+    few easy objects.
+    """
+    logits = model_output["pred_logits"].sigmoid()[0][:, :]
+    boxes = model_output["pred_boxes"][0]
+
+    box_mask = logits.max(dim=-1).values > box_threshold
+    boxes = boxes[box_mask, :]
+    scores = logits.max(dim=-1).values[box_mask]
+    # Convert the normalized cxcywh boxes to xyxy in model-input pixels.
+    (img_h, img_w) = (image_size[0], image_size[1])
+    cx, cy = img_w * boxes[:, 0], img_h * boxes[:, 1]
+    w, h = img_w * boxes[:, 2], img_h * boxes[:, 3]
+    xyxy = torch.stack([(cx - w / 2).clamp(0, img_w), (cy - h / 2).clamp(0, img_h),
+                        (cx + w / 2).clamp(0, img_w), (cy + h / 2).clamp(0, img_h)], dim=-1)
+    selected = cr.select_pseudo_exemplars(
+        xyxy.cpu().numpy(), scores.cpu().numpy(), num_exemplars,
+        strategy=strategy, nms_iou=nms_iou, grid=grid,
+        min_side=min_side if strategy == "diverse" else 0.0,
+        image_size=(img_h, img_w))
+    return torch.from_numpy(selected).to(boxes.device).float()
+
+# Define count function.
+def count(input_image, input_image_exemplars, exemplars, label, text, device="cuda"):
+    with torch.no_grad():
+        return model(
+            nested_tensor_from_tensor_list(list(input_image.to(device))),
+            nested_tensor_from_tensor_list(list(input_image_exemplars.to(device))),
+            list(exemplars.to(device)),
+            list(label.to(device)),
+            captions=[text + " ."] * len(input_image),
+        )
+
